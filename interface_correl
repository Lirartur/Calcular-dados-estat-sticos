import tkinter as tk
from tkinter import filedialog, messagebox
import prob_1_0 as programa  


def selecionar_arquivo():
    caminho = filedialog.askopenfilename(
        title="Selecione o arquivo Excel",
        filetypes=[("Arquivos Excel", "*.xlsx")]
    )
    entrada.delete(0, tk.END)
    entrada.insert(0, caminho)


def executar():
    caminho = entrada.get()

    if not caminho:
        messagebox.showerror("Erro", "Selecione um arquivo Excel!")
        return

    try:
        programa.main(caminho)
        messagebox.showinfo("Sucesso", "Análise concluída!\nVerifique a pasta do programa.")
    except Exception as e:
        messagebox.showerror("Erro", str(e))


# Janela principal
janela = tk.Tk()
janela.title("Análise Estatística")
janela.geometry("500x300")


# Label
label = tk.Label(janela, text="Selecione o arquivo Excel:")
label.pack(pady=10)

# Campo de entrada
entrada = tk.Entry(janela, width=40)
entrada.pack(pady=5)

# Botão selecionar
btn_select = tk.Button(janela, text="Procurar", command=selecionar_arquivo)
btn_select.pack(pady=5)

# Botão executar
btn_run = tk.Button(janela, text="Executar Análise", command=executar)
btn_run.pack(pady=20)

janela.mainloop()
